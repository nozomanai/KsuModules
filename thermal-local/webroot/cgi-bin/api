#!/system/bin/sh
export PATH=/system/bin:/system/xbin:/vendor/bin:/data/adb/ksu/bin:$PATH
MOD=/data/adb/modules/thermal-local
LOG=/data/adb/thermal-local.log
op=${QUERY_STRING#op=}
op=${op%%&*}

qs_arg() {
  key=$1
  case "&${QUERY_STRING}&" in
    *"&${key}="*)
      val=${QUERY_STRING#*${key}=}
      val=${val%%&*}
      printf '%s' "$val"
      ;;
  esac
}

header() {
  printf 'Status: %s\r\nContent-Type: text/plain; charset=utf-8\r\n\r\n' "$1"
}

ok() {
  header 200
}

fail() {
  header "$1"
  printf '%s\n' "$2"
  exit 0
}

read_body() {
  n=${CONTENT_LENGTH:-0}
  case "$n" in
    ''|*[!0-9]*) n=0 ;;
  esac
  if [ "$n" -gt 262144 ]; then
    fail 413 "body too large"
  fi
  if [ "$n" -eq 0 ]; then
    return 0
  fi
  dd bs="$n" count=1 2>/dev/null
}

variant_name() {
  region=$(getprop ro.miui.region 2>/dev/null | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
  hwc=$(getprop ro.boot.hwc 2>/dev/null | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
  case "$hwc" in
    IN|INDIA|*INDIA*) printf '%s\n' ind; return ;;
  esac
  case "$region" in
    IN|INDIA|*INDIA*) printf '%s\n' ind; return ;;
    CN|"")
      case "$hwc" in
        ""|CN) printf '%s\n' cn ;;
        *) printf '%s\n' gl ;;
      esac
      ;;
    *) printf '%s\n' gl ;;
  esac
}

map_path() {
  case "$1" in
    gl) printf '%s\n' /odm/etc/thermal-map-gl.conf ;;
    ind) printf '%s\n' /odm/etc/thermal-map-ind.conf ;;
    *) printf '%s\n' /vendor/etc/thermal-map.conf ;;
  esac
}

effective_variant() {
  v=$(variant_name)
  src=$(map_path "$v")
  if [ ! -f "$src" ]; then
    v=cn
  fi
  printf '%s\n' "$v"
}

case "$op" in
  mode)
    if [ "$REQUEST_METHOD" = "POST" ]; then
      read_body > "$MOD/mode.tmp"
      body=$(tr -d '\r\n' < "$MOD/mode.tmp")
      case "$body" in
        all|normal|scene|off) ;;
        *) fail 400 "bad mode" ;;
      esac
      printf '%s\n' "$body" > "$MOD/mode"
      rm -f "$MOD/mode.tmp"
      ok
      printf '%s\n' "$body"
    else
      ok
      cat "$MOD/mode" 2>/dev/null || true
    fi
    ;;
  boost|boostdefault)
    target="$MOD/boost.xml"
    if [ "$op" = "boostdefault" ]; then
      target="$MOD/boost.default.xml"
    fi
    if [ "$REQUEST_METHOD" = "POST" ]; then
      if [ "$op" != "boost" ]; then
        fail 405 "read only"
      fi
      read_body > "$target.tmp"
      mv -f "$target.tmp" "$target"
      ok
      printf 'ok\n'
    else
      if [ ! -s "$target" ] && [ "$op" = "boost" ]; then
        target="$MOD/boost.default.xml"
      fi
      if [ ! -f "$target" ]; then
        fail 404 "missing"
      fi
      ok
      cat "$target"
    fi
    ;;
  boostapply)
    result=$(sh "$MOD/boost.sh" 2>&1)
    code=$?
    printf '%s\n' "$result" >> "$LOG"
    if [ "$code" != 0 ]; then
      header 500
    else
      ok
    fi
    printf '%s\n' "$result"
    ;;
  profile|profiledefault)
    target="$MOD/profile.conf"
    if [ "$op" = "profiledefault" ]; then
      target="$MOD/profile.default"
    fi
    if [ "$REQUEST_METHOD" = "POST" ]; then
      if [ "$op" != "profile" ]; then
        fail 405 "read only"
      fi
      read_body > "$target.tmp"
      mv -f "$target.tmp" "$target"
      ok
      printf 'ok\n'
    else
      if [ ! -f "$target" ]; then
        fail 404 "missing"
      fi
      ok
      cat "$target"
    fi
    ;;
  scenemap)
    target="$MOD/scene-map.txt"
    if [ "$REQUEST_METHOD" = "POST" ]; then
      read_body > "$target.tmp"
      mv -f "$target.tmp" "$target"
      ok
      printf 'ok\n'
    else
      if [ ! -s "$target" ]; then
        fail 404 "missing"
      fi
      ok
      cat "$target"
    fi
    ;;
  setting)
    ok
    cat /odm/etc/setting.xml
    ;;
  stockmap)
    v=$(effective_variant)
    src=$(map_path "$v")
    mkdir -p "$MOD/generated"
    out="$MOD/generated/stock-map.txt"
    CLASSPATH="$MOD/thermal-crypt.dex" /system/bin/app_process /system/bin ThermalCrypt d "$src" "$out" >/dev/null 2>&1
    if [ ! -s "$out" ]; then
      fail 500 "decrypt failed"
    fi
    ok
    cat "$out"
    ;;
  variant)
    ok
    effective_variant
    ;;
  files)
    ok
    ls -1 /odm/etc/thermal-*.conf /vendor/etc/thermal-*.conf /data/vendor/thermal/config/thermal-*.conf 2>/dev/null
    ;;
  stockfiles)
    ok
    ls -1 /odm/etc/thermal-*.conf /vendor/etc/thermal-*.conf 2>/dev/null
    ;;
  edited)
    ok
    sh "$MOD/conf.sh" list 2>/dev/null || true
    ;;
  readconf)
    name=$(qs_arg name)
    err="$MOD/generated/.err"
    mkdir -p "$MOD/generated"
    if ! sh "$MOD/conf.sh" read "$name" > "$MOD/generated/.read" 2>"$err"; then
      fail 500 "$(cat "$err" 2>/dev/null)"
    fi
    ok
    cat "$MOD/generated/.read"
    ;;
  dropconf)
    name=$(qs_arg name)
    err="$MOD/generated/.err"
    mkdir -p "$MOD/generated"
    if ! sh "$MOD/conf.sh" delete "$name" > "$MOD/generated/.write" 2>"$err"; then
      fail 500 "$(cat "$err" 2>/dev/null)"
    fi
    ok
    cat "$MOD/generated/.write"
    ;;
  writeconf)
    name=$(qs_arg name)
    err="$MOD/generated/.err"
    mkdir -p "$MOD/generated"
    read_body > "$MOD/generated/.incoming"
    if ! sh "$MOD/conf.sh" write "$name" < "$MOD/generated/.incoming" > "$MOD/generated/.write" 2>"$err"; then
      fail 500 "$(cat "$err" 2>/dev/null)"
    fi
    ok
    cat "$MOD/generated/.write"
    ;;
  freqs)
    ok
    printf 'cpu0 '
    cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_frequencies 2>/dev/null
    printf '\ncpu6 '
    cat /sys/devices/system/cpu/cpu6/cpufreq/scaling_available_frequencies 2>/dev/null
    printf '\n'
    ;;
  ping)
    ok
    printf 'ok\n'
    ;;
  sconfig)
    ok
    cat /sys/class/thermal/thermal_message/sconfig 2>/dev/null
    printf '\n'
    ;;
  urls)
    ok
    sh "$MOD/remote.sh" status
    ;;
  log)
    ok
    tail -n 8 "$LOG" 2>/dev/null || true
    ;;
  apply)
    sh "$MOD/apply.sh" >/dev/null 2>&1
    code=$?
    if [ "$code" != 0 ]; then
      header 500
    else
      ok
    fi
    tail -n 8 "$LOG" 2>/dev/null || true
    ;;
  stop)
    ok
    printf 'closed\n'
    (sleep 1; sh "$MOD/remote.sh" stop) >/dev/null 2>&1 &
    ;;
  *)
    fail 404 "unknown op"
    ;;
esac
